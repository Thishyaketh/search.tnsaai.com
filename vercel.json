{
  "version": 2,
  "framework": null,
  "builds": [
    {
      "src": "searx/webapp.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9",
        "wsgi": "app"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "searx/webapp.py"
    }
  ]
}
